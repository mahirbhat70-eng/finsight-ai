# FinSight AI — environment contract (Playbook 2.5)
APP_ENV=dev                      # dev | staging | prod
LOG_LEVEL=INFO

# Database / queue
DATABASE_URL=postgresql+asyncpg://finsight:finsight@localhost:5432/finsight
REDIS_URL=redis://localhost:6379

# LLM provider adapter — one flip runs the whole test suite with zero tokens
LLM_PROVIDER=mock                # gemini | openai | mock
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Embeddings
EMBEDDING_PROVIDER=mock          # gemini | local | mock
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Ingestion / RAG tuning
CONFIDENCE_REVIEW_THRESHOLD=0.85
LLM_ASSIST_MAX_CONFIDENCE=0.75
COPILOT_TOP_K=8
RRF_K=60
CHUNK_TARGET_TOKENS=650
CHUNK_OVERLAP=0.15

# API
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Phase 7 (auth / limits) — fill before prod
JWT_SECRET=change-me-32-chars-minimum
ACCESS_TOKEN_MINUTES=30
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_COPILOT=10/minute
RATE_LIMIT_EXPORTS=5/minute
