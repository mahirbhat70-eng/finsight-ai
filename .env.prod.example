# FinSight AI — Production Environment Variables
# Copy this to .env.prod on your server and fill in the values.
# NEVER commit the real .env.prod to git.

# ---- Domain (required) ----
DOMAIN=finsight.yourdomain.com

# ---- Database (required) ----
DB_USER=finsight
DB_PASSWORD=changeme-strong-password
DB_NAME=finsight

# ---- Security (required) ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme-at-least-32-characters-long

# ---- LLM (required) ----
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_KEY=your-gemini-api-key-here

# ---- CORS (match your domain) ----
CORS_ORIGINS=https://finsight.yourdomain.com

# ---- Optional tuning ----
APP_ENV=prod
CONFIDENCE_REVIEW_THRESHOLD=0.85
LLM_ASSIST_MAX_CONFIDENCE=0.75
